# Nothing in here is served over the web. Attachments are read from the
# server (File Manager / FTP) or through the admin page, never by URL.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
Options -Indexes
php_flag engine off
